{
  "_comment": "Orbit Browser's first-run defaults (Chromium's initial_preferences / master preferences). Shipped beside the browser; these are defaults a person can still change. What a person cannot change is locked in policies/orbit.json. scripts/build.py stages this into each package.",
  "homepage": "https://ai.orbit.com.ai/",
  "homepage_is_newtabpage": true,
  "browser": {
    "show_home_button": true,
    "check_default_browser": false,
    "has_seen_welcome_page": true
  },
  "bookmark_bar": {
    "show_on_all_tabs": true
  },
  "distribution": {
    "import_bookmarks": false,
    "import_history": false,
    "import_search_engine": false,
    "make_chrome_default": false,
    "make_chrome_default_for_user": false,
    "suppress_first_run_default_browser_prompt": true,
    "suppress_first_run_bubble": true,
    "do_not_create_desktop_shortcut": false,
    "do_not_create_quick_launch_shortcut": true,
    "do_not_launch_chrome": true,
    "verbose_logging": false,
    "skip_first_run_ui": true
  },
  "first_run_tabs": [
    "https://ai.orbit.com.ai/"
  ],
  "default_search_provider_enabled": true,
  "safebrowsing": {
    "enabled": false
  },
  "spellcheck": {
    "use_spelling_service": false
  },
  "profile": {
    "_comment_cookies": "ungoogled-chromium defaults site data to clear-on-exit (chrome://settings/content/siteData -> 'Delete data sites have saved ... when you close all windows'), which is the cookies content setting SESSION_ONLY (4). Orbit sets it back to Allow (1) so sites keep their data; a person can still change it.",
    "default_content_setting_values": {
      "cookies": 1
    }
  }
}
